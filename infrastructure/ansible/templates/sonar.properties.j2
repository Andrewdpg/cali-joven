# SonarQube Configuration Template
# Generated by Ansible

# Database Configuration
sonar.jdbc.url=jdbc:postgresql://{{ postgresql_host }}:{{ postgresql_port }}/{{ postgresql_database }}?currentSchema=public
sonar.jdbc.username={{ postgresql_username }}
sonar.jdbc.password={{ postgresql_password }}

# Web Server Configuration
sonar.web.host=0.0.0.0
sonar.web.port={{ sonar_port }}
sonar.web.context=/sonarqube

# Security Configuration
sonar.security.realm=LDAP
sonar.authenticator.downcase=true
sonar.forceAuthentication=true

# Performance Configuration
sonar.ce.javaOpts=-Xmx2g -XX:+HeapDumpOnOutOfMemoryError
sonar.web.javaOpts=-Xmx1g -XX:+HeapDumpOnOutOfMemoryError

# Logging Configuration
sonar.log.level=INFO
sonar.log.console=true
sonar.log.rollingPolicy=time:yyyy-MM-dd
sonar.log.maxFiles=10

# Plugin Configuration
sonar.plugins.downloadOnlyRequired=true

# Search Configuration
sonar.search.javaOpts=-Xmx1g -XX:+HeapDumpOnOutOfMemoryError

# Additional Configuration
sonar.telemetry.enable=false
sonar.issue.ignore.multicriteria=e1
sonar.issue.ignore.multicriteria.e1.ruleKey=*:S1186
sonar.issue.ignore.multicriteria.e1.resourceKey=**/*.ts

